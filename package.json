    "test:live": "FORAGE_LIVE=1 node --test game/live.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@rarefriends/friendsdk": "file:vendor/rarefriends-friendsdk-0.1.3.tgz",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "viem": "2.56.3"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "typescript": "6.0.3"
  }
}
